# Stage 1: Prepare application dependencies and folder structure
FROM node:20 AS builder
WORKDIR /app

# 1. Optimize layer caching for dependencies
COPY package*.json ./
RUN npm ci

# 2. Copy the entire source code into the builder stage
COPY . .

# 3. Strip out heavy development packages before copying
RUN npm prune --production


# Stage 2: Minimalist Production Runner Stage
FROM gcr.io/distroless/nodejs20-debian12 AS runner
WORKDIR /app

# 4. Copy production dependencies directly
COPY --from=builder /app/node_modules ./node_modules

# 5. Mirror the file mapping from your original "build" script using Docker native copy rules
COPY --from=builder /app/src ./src
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/README.md ./README.md
COPY --from=builder /app/LICENSE ./LICENSE

# Copy configuration files (matches your wildcard rules safely)
COPY --from=builder /app/*.yml ./
COPY --from=builder /app/*.yaml ./
COPY --from=builder /app/appspec.yml ./

# 6. Execute the entry point application script directly
CMD ["src/index.js"]
